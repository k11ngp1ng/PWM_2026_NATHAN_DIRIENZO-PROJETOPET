<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VanderPet.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:VanderPet.Views"
    Title="VanderPet"
    Shell.NavBarIsVisible="False">

	<Shell.Resources>
		<Style TargetType="TabBar">
			<Setter Property="Shell.TabBarBackgroundColor" Value="#FFFFFF" />
			<Setter Property="Shell.TabBarTitleColor" Value="#718096" />
			<Setter Property="Shell.TabBarUnselectedColor" Value="#718096" />
		</Style>
	</Shell.Resources>

	<TabBar>
		<Tab Title="Agendar">
			<ShellContent ContentTemplate="{DataTemplate views:AgendamentoPage}" />
		</Tab>

		<!-- NOVA ABA: Gerenciamento de Pets -->
		<Tab Title="Meus Pets">
			<ShellContent ContentTemplate="{DataTemplate views:PetsPage}" />
		</Tab>

		<Tab Title="Histórico">
			<ShellContent ContentTemplate="{DataTemplate views:HistoricoPage}" />
		</Tab>
	</TabBar>

</Shell>