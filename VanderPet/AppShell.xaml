<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VanderPet.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:VanderPet.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarTitleColor="#3A8D7A"
    Shell.TabBarUnselectedColor="#718096">

	<TabBar>
		<!-- Aba 1: A tela principal exigida pelo fluxo -->
		<Tab Title="Agendamentos" >
			<ShellContent ContentTemplate="{DataTemplate views:HistoricoPage}" />
		</Tab>

		<!-- Aba 2: Lista de Pets -->
		<Tab Title="Meus Pets" >
			<ShellContent ContentTemplate="{DataTemplate views:PetsPage}" />
		</Tab>
	</TabBar>

</Shell>