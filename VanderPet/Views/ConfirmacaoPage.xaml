<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPet.Views.ConfirmacaoPage"
             Title="Confirmar Agendamento"
             BackgroundColor="#F7F9F8">

	<ScrollView>
		<VerticalStackLayout Padding="20,30" Spacing="20">

			<Label Text="Resumo do Pedido" FontSize="24" FontAttributes="Bold" TextColor="#3A8D7A"/>
			<Label Text="Quase lá! Confira os dados antes de finalizar." TextColor="#718096" Margin="0,0,0,10"/>

			<Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" Padding="20" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="15">

					<Grid ColumnDefinitions="100, *">
						<Label Grid.Column="0" Text="🐾 Pet:" FontAttributes="Bold" TextColor="#718096"/>
						<Label Grid.Column="1" x:Name="lblPet" TextColor="#263238" FontAttributes="Bold"/>
					</Grid>

					<Grid ColumnDefinitions="100, *">
						<Label Grid.Column="0" Text="✂️ Serviço:" FontAttributes="Bold" TextColor="#718096"/>
						<Label Grid.Column="1" x:Name="lblServico" TextColor="#263238" FontAttributes="Bold"/>
					</Grid>

					<Grid ColumnDefinitions="100, *">
						<Label Grid.Column="0" Text="📅 Data:" FontAttributes="Bold" TextColor="#718096"/>
						<Label Grid.Column="1" x:Name="lblData" TextColor="#263238"/>
					</Grid>

					<Grid ColumnDefinitions="100, *">
						<Label Grid.Column="0" Text="⏰ Horário:" FontAttributes="Bold" TextColor="#718096"/>
						<Label Grid.Column="1" x:Name="lblHorario" TextColor="#263238"/>
					</Grid>

					<BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,5"/>

					<Grid ColumnDefinitions="*, Auto">
						<Label Grid.Column="0" Text="Total a pagar:" FontAttributes="Bold" TextColor="#263238" VerticalOptions="Center"/>
						<Label Grid.Column="1" x:Name="lblTotal" TextColor="#3A8D7A" FontSize="20" FontAttributes="Bold"/>
					</Grid>

				</VerticalStackLayout>
			</Border>

			<Label Text="Observações para o Pet Shop (Opcional)" FontAttributes="Bold" TextColor="#263238" Margin="0,10,0,0"/>
			<Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 8" Padding="10,5">
				<Editor x:Name="edtObservacoes" 
                        Placeholder="Ex: O Thor tem muito medo do barulho do secador..." 
                        HeightRequest="80" 
                        TextColor="#263238" />
			</Border>

			<VerticalStackLayout Spacing="15" Margin="0,20,0,0">
				<Button Text="CONFIRMAR E AGENDAR"
                        BackgroundColor="#3A8D7A"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="50"
                        Clicked="OnConfirmarFinalTapped"/>

				<Button Text="VOLTAR E EDITAR"
                        BackgroundColor="Transparent"
                        TextColor="#718096"
                        FontAttributes="Bold"
                        Clicked="OnVoltarTapped"/>
			</VerticalStackLayout>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>