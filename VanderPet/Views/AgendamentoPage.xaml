<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPet.Views.AgendamentoPage"
             xmlns:models="clr-namespace:VanderPet.Models"
             BackgroundColor="#F7F9F8"
             Title="Novo Agendamento"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

	<ScrollView>
		<VerticalStackLayout Padding="20,30,20,40" Spacing="20">

			<HorizontalStackLayout Margin="0,0,0,5">
				<Label Text="← Voltar" TextColor="#718096" FontSize="16" FontAttributes="Bold" VerticalOptions="Center">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnVoltarTapped" />
					</Label.GestureRecognizers>
				</Label>
			</HorizontalStackLayout>

			<Label Text="Novo Agendamento" FontSize="26" FontAttributes="Bold" TextColor="#3A8D7A" Margin="0,0,0,10"/>

			<Grid ColumnDefinitions="*, Auto" Margin="0,0,0,-10">
				<Label Grid.Column="0" Text="Para qual pet é o agendamento?" FontSize="16" TextColor="#718096" FontAttributes="Bold" VerticalOptions="End"/>
				<Label Grid.Column="1" Text="+ Novo Pet" TextColor="#3A8D7A" FontSize="14" FontAttributes="Bold" VerticalOptions="End">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnNovoPetTapped" />
					</Label.GestureRecognizers>
				</Label>
			</Grid>

			<Border Stroke="#E2E8F0" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="5,0">
				<Picker x:Name="pckPet" Title="Selecione seu companheiro" ItemDisplayBinding="{Binding Nome}" TextColor="#263238" />
			</Border>

			<Label Text="Qual o porte do pet para este serviço?" FontSize="16" TextColor="#718096" FontAttributes="Bold" Margin="0,10,0,0"/>
			<Border Stroke="#E2E8F0" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="5,0">
				<!-- ADICIONADO: SelectedIndexChanged="OnPorteChanged" -->
				<Picker x:Name="pckPorte" Title="Selecione o porte" TextColor="#263238" SelectedIndexChanged="OnPorteChanged">
					<Picker.ItemsSource>
						<x:Array Type="{x:Type x:String}">
							<x:String>Pequeno</x:String>
							<x:String>Médio</x:String>
							<x:String>Grande</x:String>
						</x:Array>
					</Picker.ItemsSource>
				</Picker>
			</Border>

			<Label Text="Qual serviço deseja?" FontSize="16" TextColor="#718096" FontAttributes="Bold" Margin="0,10,0,0"/>

			<!-- Cards de Serviço Otimizados -->
			<VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding ListaServicos}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:ServicoExibicao">

						<!-- ADICIONADO: Binding das cores dinâmicas -->
						<Border Stroke="{Binding BorderColor}" BackgroundColor="{Binding BackgroundColor}" StrokeThickness="2" StrokeShape="RoundRectangle 8" Padding="15">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Tapped="OnServicoTapped" CommandParameter="{Binding .}"/>
							</Border.GestureRecognizers>

							<Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
								<Label Grid.Row="0" Grid.Column="0" Text="{Binding Servico}" FontAttributes="Bold" FontSize="16" TextColor="#3A8D7A"/>
								<Label Grid.Row="0" Grid.Column="1" Text="{Binding PrecoFormatado}" FontAttributes="Bold" TextColor="#263238"/>
								<Label Grid.Row="1" Grid.Column="0" Text="{Binding Descricao}" FontSize="12" TextColor="#718096" Margin="0,5,0,0"/>
								<!-- ADICIONADO: Tempo dinâmico -->
								<Label Grid.Row="1" Grid.Column="1" Text="{Binding DuracaoFormatada}" FontSize="12" TextColor="#718096" FontAttributes="Bold" Margin="0,5,0,0" HorizontalOptions="End"/>
							</Grid>
						</Border>

					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
			<!-- Removido o Label vermelho de "Nenhum serviço selecionado" -->

			<Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
				<VerticalStackLayout Grid.Column="0" Spacing="5">
					<Label Text="Data" FontSize="16" TextColor="#718096" FontAttributes="Bold"/>
					<Border Stroke="#E2E8F0" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="5,0">
						<DatePicker x:Name="dtpData" Format="dd/MM/yyyy" TextColor="#263238"/>
					</Border>
				</VerticalStackLayout>

				<VerticalStackLayout Grid.Column="1" Spacing="5">
					<Label Text="Horário" FontSize="16" TextColor="#718096" FontAttributes="Bold"/>
					<Border Stroke="#E2E8F0" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="5,0">
						<Picker x:Name="pckHorario" Title="Selecione" TextColor="#263238" ItemDisplayBinding="{Binding HoraTexto}"/>
					</Border>
				</VerticalStackLayout>
			</Grid>

			<Button Text="AVANÇAR PARA RESUMO" BackgroundColor="#3A8D7A" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="0,20,0,0" Clicked="OnAvancarClicked"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>